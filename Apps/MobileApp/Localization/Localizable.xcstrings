            "value": "デバイスの同期"
          }
        }
      }
    },
    "跨设备": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Across Devices"
          }
        },
        "ja": {
          "stringUnit": {
