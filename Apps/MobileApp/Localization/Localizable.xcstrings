          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "壁紙 ID が無効です。「ソース:画像 ID」の形式で指定してください（例: bing:OHR.Example）。"
          }
        }
      }
    },
    "壁纸 ID 无效：%@。请使用“来源:图片 ID”格式，例如 bing:OHR.Example。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid wallpaper ID: %@. Use the “source:image ID” format, for example bing:OHR.Example."
          }
        },
        "ja": {
          "stringUnit": {
