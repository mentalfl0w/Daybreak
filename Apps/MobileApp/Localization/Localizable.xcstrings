            "value": "診断"
          }
        }
      }
    },
    "导出同步诊断日志": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export Sync Diagnostic Log"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期の診断ログを書き出す"
          }
        }
      }
    },
    "正在准备诊断日志…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing Diagnostic Log…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "診断ログを準備中…"
          }
        }
      }
    },
    "诊断报告会记录应用与系统版本、同步状态、最近的同步阶段和错误类别；不含文件夹路径、文件夹访问信息、壁纸或文字内容、设备名称。报告只在本机生成；你可以通过系统分享面板决定是否分享。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The report includes app and system versions, sync status, recent sync steps, and error categories. It excludes folder paths, folder access information, wallpaper or story content, and the device name. The report is created on this device; you choose whether to share it from the system share sheet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "診断レポートには、アプリとシステムのバージョン、同期状態、最近の同期手順、エラー分類が記録されます。フォルダのパスやアクセス情報、壁紙・ストーリーの内容、デバイス名は含まれません。レポートはこのデバイスで作成され、システムの共有シートから共有するか選べます。"
          }
        }
      }
    },
    "无法导出诊断日志": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t Export Diagnostic Log"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "診断ログを書き出せません"
          }
        }
      }
    },
    "诊断日志未能写入临时文件。请重试。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The diagnostic log couldn’t be written to a temporary file. Please try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "診断ログを一時ファイルに書き込めませんでした。もう一度お試しください。"
          }
        }
      }
    },
    "同步通过你选择的 iCloud Drive 文件夹进行。每台设备保留独立的本地数据，只交换版本化记录与资源文件，不共享活动数据库或索引。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync uses the iCloud Drive folder you choose. Each device keeps its own local data and exchanges only versioned records and asset files, never a live database or index."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期は選択した iCloud Drive のフォルダを通じて行われます。各デバイスは独立したローカルデータを保持し、バージョン管理された記録とリソースファイルのみを交換します。稼働中のデータベースやインデックスは共有しません。"
          }
        }
      }
    },
