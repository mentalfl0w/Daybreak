          "stringUnit": {
            "state": "translated",
            "value": "Clearing the cache only deletes local image files; metadata, stories, and favorites are managed separately on the Cache page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュを消去すると本機の画像ファイルだけが削除されます。メタデータ、ストーリー、お気に入りは「キャッシュ」ページで個別に管理されます。"
          }
        }
      }
