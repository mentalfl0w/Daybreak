    "正在准备诊断日志…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing Diagnostic Log…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "診断ログを準備中…"
          }
        }
      }
    },
    "诊断日志包含应用与系统版本、同步状态、最近同步阶段记录和错误类别；不包含文件夹路径、授权书签、壁纸或文字内容、设备名称。文件仅在本机生成，分享去向由你在系统分享面板中选择。": {
    "iPad 横屏": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPad Landscape"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPad 横向き"
          }
        }
      }
    },
    "iPad 横屏裁切": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPad landscape crop"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPad 横向きの切り抜き"
          }
        }
      }
    },
    "iPad 横屏裁切导出": {
      "extractionState": "manual",
      "localizations": {
