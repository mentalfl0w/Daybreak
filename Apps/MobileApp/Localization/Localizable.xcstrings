    "图片、缓存与介绍只保存在这台设备上。Daybreak 没有账号系统、遥测、广告或后端服务，也不会上传浏览记录。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Images, cache, and stories are stored only on this device. Daybreak has no account system, telemetry, ads, or backend services, and doesn't upload browsing history."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像、キャッシュ、ストーリーはこのデバイスにのみ保存されます。Daybreak にはアカウントシステム、テレメトリ、広告、バックエンドサービスがなく、閲覧履歴をアップロードすることもありません。"
          }
        }
      }
    },
    "图片与来源": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Images & sources"
