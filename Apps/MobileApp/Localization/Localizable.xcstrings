    "默认同步收藏与固定日期、日期与地区记录、壁纸元数据、介绍与版权、缩略图。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Synced by default: favorites and pinned dates, date-and-region records, wallpaper metadata, stories and copyright, and thumbnails."
          }
        },
        "ja": {
          "stringUnit": {
