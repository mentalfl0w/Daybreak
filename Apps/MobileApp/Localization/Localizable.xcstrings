    "诊断": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostics"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "診断"
          }
        }
      }
    },
    "导出同步诊断日志": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export Sync Diagnostic Log"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期の診断ログを書き出す"
          }
        }
      }
    },
    "正在准备诊断日志…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing Diagnostic Log…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "診断ログを準備中…"
          }
        }
      }
    },
    "诊断日志包含应用与系统版本、同步状态、最近同步阶段记录和错误类别；不包含文件夹路径、授权书签、壁纸或文字内容、设备名称。文件仅在本机生成，分享去向由你在系统分享面板中选择。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The diagnostic log includes app and system versions, sync status, recent sync stage records and error categories. It never includes folder paths, authorization bookmarks, wallpaper or story content, or the device name. The file is generated on this device only; you choose where it goes in the system share sheet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "診断ログにはアプリとシステムのバージョン、同期状態、最近の同期段階の記録、エラー分類が含まれます。フォルダのパス、認可ブックマーク、壁紙や文章の内容、デバイス名は含まれません。ファイルはこの端末内でのみ生成され、共有先はシステムの共有シートで選択します。"
          }
        }
      }
    },
    "无法导出诊断日志": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t Export Diagnostic Log"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "診断ログを書き出せません"
          }
        }
      }
    },
    "诊断日志未能写入临时文件。请重试。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The diagnostic log couldn’t be written to a temporary file. Please try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "診断ログを一時ファイルに書き込めませんでした。もう一度お試しください。"
          }
        }
      }
    },
    "同步通过你选择的 iCloud Drive 文件夹进行。每台设备保留独立的本地数据，只交换版本化记录与资源文件，不共享活动数据库或索引。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync uses the iCloud Drive folder you choose. Each device keeps its own local data and exchanges only versioned records and asset files, never a live database or index."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期は選択した iCloud Drive のフォルダを通じて行われます。各デバイスは独立したローカルデータを保持し、バージョン管理された記録とリソースファイルのみを交換します。稼働中のデータベースやインデックスは共有しません。"
          }
        }
      }
    },
    "在此设备启用同步": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Sync on This Device"
          }
        },
        "ja": {
