        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync Content Region Preference"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテンツ地域の設定を同期"
          }
        }
      }
    },
    "同步原图": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync Originals"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元画像を同期"
          }
        }
      }
    },
    "同步完成只表示本机已处理并写入记录，不代表其他设备已接收或已应用。文件同步不是跨设备锁。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A completed sync means only that this device processed and wrote records; it does not mean other devices have received or applied them. File sync is not a cross-device lock."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期の完了は、このデバイスが記録を処理して書き込んだことだけを示します。他のデバイスが受信または適用したことを意味しません。ファイル同期はデバイス間のロックではありません。"
          }
        }
      }
    },
    "同步已关闭": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync is off"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期はオフです"
          }
        }
      }
    },
    "同步已关闭，Daybreak 不会读写此文件夹。重新开启后可继续使用。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync is off, so Daybreak will not read or write this folder. Turn sync back on to continue using it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期がオフのため、Daybreak はこのフォルダの読み書きを行いません。同期を再度オンにすると使用を再開できます。"
          }
        }
      }
    },
    "同步失败": {
      "extractionState": "manual",
      "localizations": {
