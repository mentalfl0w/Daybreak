    "取消收藏 %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unfavorite %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ をお気に入りから削除"
          }
        }
      }
    },
    "取消收藏前会显示确认": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A confirmation appears before removing from favorites"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りを解除する前に確認を表示します"
          }
        }
      }
    },
    "取消收藏后，该图片不再因收藏而受保护；后续缓存清理可能删除其缩略图或原图。本机元数据、介绍以及固定日期/当前壁纸保护不受影响。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After removing from favorites, the image is no longer protected by favorite status; future cache clean up may delete its thumbnail or original image. Local metadata, stories, and pinned date/current wallpaper protection are unaffected."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りから削除すると、その画像はお気に入りによる保護の対象外になります。今後のキャッシュクリーンアップでサムネイルまたはオリジナル画像が削除される可能性があります。ローカルのメタデータ、ストーリー、固定日付/現在の壁紙による保護は影響を受けません。"
          }
        }
      }
    },
    "取消收藏这张图片": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this image from favorites"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画像のお気に入りを解除"
          }
        }
      }
    },
    "取消收藏（需要确认）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove from favorites (confirmation required)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りを解除（確認が必要）"
          }
        }
      }
    },
    "取消这张图片的收藏？": {
      "extractionState": "manual",
      "localizations": {
