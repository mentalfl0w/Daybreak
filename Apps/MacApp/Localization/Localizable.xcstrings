    "界面语言独立于内容地区；更改后重新启动 Daybreak 生效。Bing 来源介绍不会被自动翻译。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The interface language is independent of the content region. Restart Daybreak for the change to take effect. Bing source stories are never translated automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示言語はコンテンツ地域とは独立しています。変更を反映するには Daybreak を再起動してください。Bing の元の紹介文は自動翻訳されません。"
          }
        }
      }
    },
    "让桌面壁纸与所选地区的今日图片保持一致。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the desktop wallpaper in sync with today's image from the selected region."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップ壁紙を選択地域の今日の画像と同期します。"
          }
        }
      }
    },
    "自动同步桌面壁纸": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync desktop wallpaper automatically"
          }
        },
        "ja": {
