          }
        }
      }
    },
    "未设为登录时启动": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not set to launch at login"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時に起動する設定はありません"
          }
        }
      }
    },
    "需要在系统设置中批准": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requires approval in System Settings"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定での承認が必要です"
          }
        }
      }
    },
    "系统未找到此应用的登录项记录": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system couldn't find this app's login item record"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリのログイン項目レコードがシステムで見つかりません"
          }
        }
      }
    },
    "登录项由 macOS 管理。请确认 Daybreak 位于“应用程序”文件夹并从该副本运行；从构建目录或临时位置运行时，系统可能找不到登录项记录。调整后请重新打开 Daybreak，再重新检测；如果问题持续，请在系统设置的登录项中检查。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS manages login items. Make sure Daybreak is in the Applications folder and running from that copy; when it runs from a build directory or temporary location, the system may not find its login item record. Reopen Daybreak after moving or reinstalling it, then check again. If the problem continues, review Login Items in System Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン項目は macOS が管理します。Daybreak が「アプリケーション」フォルダにあり、そのコピーから実行されていることを確認してください。ビルドディレクトリや一時的な場所から実行している場合、システムがログイン項目のレコードを見つけられないことがあります。移動または再インストール後に Daybreak を開き直し、再確認してください。問題が続く場合は、システム設定のログイン項目を確認してください。"
          }
        }
      }
    },
    "系统返回了无法识别的登录项状态。请重新检测；如果问题持续，请在系统设置的登录项中检查。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system returned an unrecognized login item status. Check again; if the problem continues, review Login Items in System Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムから認識できないログイン項目の状態が返されました。再確認してください。問題が続く場合は、システム設定のログイン項目を確認してください。"
          }
        }
      }
    },
    "系统尚未确认登录项更改。请重新检测或在系统设置的登录项中检查。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system hasn't confirmed the login item change. Check again, or review Login Items in System Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン項目の変更をまだ確認できません。再確認するか、システム設定のログイン項目を確認してください。"
          }
        }
      }
    },
