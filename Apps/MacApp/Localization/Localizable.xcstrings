        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリフライトをキャンセル"
          }
        }
      }
    },
    "受保护内容": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protected content"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保護対象"
          }
        }
      }
    },
    "受保护图片不能被单独删除": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protected images can't be deleted individually"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保護された画像は個別に削除できません"
          }
        }
      }
    },
    "只列出本机有记录的月份；未列出的月份表示没有本地记录，不代表 Bing 当时没有发布图片。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only months with local records are listed; unlisted months mean no local records, not that Bing didn't publish images then."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本機に記録がある月だけを表示します。未表示の月はローカル記録がないという意味で、Bing が当時画像を公開していなかったという意味ではありません。"
          }
        }
      }
    },
    "只删除已缓存的每日介绍；图片、元数据与收藏不受影响。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only deletes cached daily stories; images, metadata, and favorites are unaffected."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュ済みのデイリーストーリーのみを削除します。画像、メタデータ、お気に入りには影響しません。"
          }
        }
      }
    },
    "只删除未受保护的原图；需要时可在联网后重新下载。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only deletes unprotected original images; they can be re-downloaded when online if needed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保護されていないオリジナル画像のみを削除します。必要に応じて、オンライン時に再ダウンロードできます。"
          }
        }
      }
    },
    "只删除未被收藏、固定或当前应用保护的缩略图；原图与介绍保留。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only deletes thumbnails that aren't favorited, pinned, or currently protected; original images and stories are kept."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入り、固定日付、または現在適用されている保護の対象外のサムネイルのみを削除します。オリジナル画像とストーリーは保持されます。"
          }
        }
      }
    },
    "只删除未被收藏、固定日期或当前壁纸保护的原图。缩略图、元数据、介绍和收藏都会保留；删除的原图需要重新下载才能设为壁纸。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only deletes original images that are not protected by favorites, pinned dates, or the current wallpaper. Thumbnails, metadata, stories, and favorites are preserved; deleted original images must be downloaded again before they can be set as wallpaper."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入り、固定日付、現在の壁紙で保護されていないオリジナル画像のみを削除します。サムネイル、メタデータ、ストーリー、お気に入りは保持されます。削除されたオリジナル画像は、壁紙に設定するために再ダウンロードが必要です。"
          }
        }
      }
    },
    "只删除未被收藏、固定日期或当前壁纸保护的缩略图。原图、元数据、介绍和收藏都会保留，缩略图可在联网后重新缓存。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only deletes thumbnails that are not protected by favorites, pinned dates, or the current wallpaper. Original images, metadata, stories, and favorites are preserved; thumbnails can be cached again once online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入り、固定日付、現在の壁紙で保護されていないサムネイルのみを削除します。オリジナル画像、メタデータ、ストーリー、お気に入りは保持されます。サムネイルはオンライン後に再キャッシュできます。"
          }
        }
      }
    },
    "只显示本机实际归档的日期，不会补造图片或介绍。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show only dates actually archived on this Mac; no images or stories will be fabricated."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacで実際にアーカイブされた日付のみを表示します。画像やストーリーを新たに作成することはありません。"
          }
        }
      }
    },
    "只有 %lld 个有记录的日期。这里只展示实际存在的内容，不生成“全年最佳”或“完整年度”结论。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only %lld dates have records. This view shows only what actually exists and does not generate “Best of the Year” or “complete year” conclusions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録がある日付は %lld 日だけです。ここでは実際に存在する内容のみを表示し、「年間ベスト」や「年間全体」の結論は生成しません。"
          }
        }
      }
    },
    "只移除本应用缓存目录中未被索引引用的孤立文件，并报告索引中缺失的文件。不会删除元数据、介绍、收藏或受保护图片。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only removes orphaned files in this app's cache directory that are not referenced by the index, and reports files missing from the index. Metadata, stories, favorites, and protected images are not deleted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリのキャッシュディレクトリ内で、インデックスから参照されていない孤立ファイルのみを削除し、インデックスに存在しないファイルを報告します。メタデータ、ストーリー、お気に入り、保護された画像は削除されません。"
          }
        }
      }
    },
    "只通过公开 API 修改当前可访问桌面；不会承诺同时更新未激活 Space。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only modifies the currently accessible desktop via public API; doesn't promise to update an inactive Space at the same time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開 API 経由で現在アクセス可能なデスクトップだけを変更します。非アクティブな Space の同時更新は保証しません。"
          }
        }
      }
    },
    "可清理": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleanable"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリーンアップ可能"
          }
        }
      }
    },
    "同一天可能包含多个地区的记录；同一张图片也可能跨日期或地区重复出现。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One day may contain records from multiple regions; the same image may also appear across dates or regions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日の中に複数の地域の記録が含まれる場合があります。同じ画像が日付や地域をまたいで重複して出現することもあります。"
          }
        }
      }
    },
    "含介绍 %lld 天": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld days with stories"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストーリーあり %lld日"
          }
        }
      }
    },
    "含可能仍被其他 Space 引用的历史图片": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes historical images that may still be referenced by another Space"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他の Space からまだ参照されている可能性がある履歴画像を含みます"
          }
        }
      }
    },
    "启动时无法进入只读模式：%@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
