    },
    "Bing 图片与文字版权归原权利人；应用源代码以 MIT 许可发布。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bing images and text are copyrighted by their respective owners; the app source code is released under the MIT License."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bing の画像とテキストの著作権は各権利者に帰属します。アプリのソースコードは MIT ライセンスで公開されています。"
          }
        }
      }
    },
    "Bing 图片接口不可用": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bing image API unavailable"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bing画像APIを利用できません"
          }
        }
      }
    },
    "Bing 尚未发布该地区今日内容；当前最新来源日期为 %@。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bing hasn't published today's content for this region yet; the latest source date is %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bing はこの地域の今日のコンテンツをまだ公開していません。現在の最新ソース日付は %@ です。"
          }
        }
      }
    },
    "Bing 未返回任何图片条目": {
