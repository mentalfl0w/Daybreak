      }
    },
    "图片、元数据与来源介绍只保存在本机；Daybreak 不上传浏览记录，也不包含账号系统或后端服务。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Images, metadata, and source stories stay on this Mac. Daybreak does not upload browsing history and has no account system or backend service."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像、メタデータ、元の紹介文はこの Mac にのみ保存されます。Daybreak は閲覧履歴をアップロードせず、アカウントシステムやバックエンドサービスもありません。"
          }
        }
      }
    },
    "登录时启动 Daybreak": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch Daybreak at login"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時に Daybreak を起動"
          }
        }
      }
    },
    "登录项状态": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Login item status"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン項目の状態"
          }
        }
      }
    },
    "已设为登录时启动": {
      "extractionState": "manual",
