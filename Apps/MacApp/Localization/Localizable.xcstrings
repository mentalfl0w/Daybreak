          }
        }
      }
    },
    "触发时机": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When it runs"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行タイミング"
          }
        }
      }
    },
    "启动、刷新、日期变化、Space 切换、显示器变化、系统唤醒": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch, refresh, date change, Space change, display change, and wake"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動、更新、日付変更、Space 切り替え、ディスプレイ変更、スリープ解除"
          }
        }
      }
    },
    "内容来源": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Content source"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテンツの取得元"
          }
        }
      }
    },
    "所选地区的 Bing 每日图片与介绍": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bing daily image and story for the selected region"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択地域の Bing デイリー画像と紹介"
          }
        }
      }
    },
    "Daybreak 会在上述时机获取所选地区的最新内容，并在写入门禁允许时更新桌面壁纸。未激活 Space 只在切换后恢复，不会被承诺即时更新。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daybreak fetches the latest content for the selected region at those moments and updates the desktop wallpaper when the write gate allows it. Inactive Spaces are restored after you switch to them; they are not promised an immediate update."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Daybreak はこれらのタイミングで選択地域の最新コンテンツを取得し、書き込みゲートが許可した場合にデスクトップ壁紙を更新します。非アクティブな Space は切り替え後に復元され、即時更新は保証されません。"
          }
        }
      }
    },
    "每天一幅风景，每天一个故事": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A landscape a day, a story a day"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日1枚の風景、毎日1つの物語"
          }
        }
      }
    },
    "Daybreak 把 Bing 每日壁纸、当期介绍、时光日历和本地回顾放进一个原生 macOS 应用。每天一张图，一段故事；离线也能读，收藏不会丢。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daybreak brings Bing's daily wallpaper, editorial story, timeline calendar, and local recap into one native macOS app. One image and one story each day, readable offline, with favorites kept safe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Daybreak は Bing のデイリー壁紙、その日の紹介、タイムラインカレンダー、ローカル振り返りを 1 つのネイティブ macOS アプリにまとめます。毎日 1 枚の画像と 1 つの物語を、オフラインでも読め、お気に入りは失われません。"
          }
        }
      }
    },
    "每日 Bing 壁纸与来源介绍": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily Bing wallpaper and source story"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日の Bing 壁紙と元の紹介"
          }
        }
      }
    },
    "本机缓存、收藏与年度回顾": {
      "extractionState": "manual",
