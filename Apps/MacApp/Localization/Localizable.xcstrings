            "value": "Deleted this thumbnail cache; original images, metadata, stories, and favorites were unaffected."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサムネイルのキャッシュを削除しました。オリジナル画像、メタデータ、ストーリー、お気に入りは影響を受けていません。"
          }
        }
      }
    },
    "已加入收藏。收藏图片不会被自动缓存清理。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added to favorites. Favorite images are not removed by automatic cache clean up."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りに追加しました。お気に入りの画像は自動キャッシュクリーンアップの対象になりません。"
          }
        }
      }
    },
    "已取消收藏。收藏按图片记录，同一图片的其他日期也已同步更新。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removed from favorites. Favorites are tracked by image, so other dates for the same image have also been updated."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りを解除しました。お気に入りは画像単位で記録され、同じ画像の他の日付も同期して更新されました。"
          }
        }
      }
    },
    "已取消收藏；该图片不再受收藏保护，后续缓存清理可能删除其缓存文件。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removed from favorites; this image is no longer protected as a favorite, and later cache clean up may delete its cache files."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りを解除しました。この画像はお気に入りとして保護されず、今後のキャッシュ整理でキャッシュファイルが削除される可能性があります。"
          }
        }
      }
    },
    "已取消收藏；该图片仍受固定日期或当前壁纸保护。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removed from favorites; this image is still protected by a pinned date or the current wallpaper."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りを解除しました。この画像は固定日付または現在の壁紙によって引き続き保護されています。"
          }
        }
      }
    },
    "已按内置上限清理 %lld 个缓存文件，释放 %@。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
