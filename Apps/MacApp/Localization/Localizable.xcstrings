    "应用壁纸": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply wallpaper"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "壁紙を適用"
          }
        }
      }
    },
    "开启本身不会立即写入。只有后续 Space、显示器或唤醒事件才会按写入门禁检查；未知或受保护的壁纸会暂停等待逐屏确认。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning it on doesn't write immediately. Only later Space, display, or wake events are checked by the write gate; unknown or protected wallpapers pause for per-display confirmation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにしただけではすぐには書き込みません。以降の Space、ディスプレイ、またはウェイクイベントのみが書き込みゲートで確認されます。不明または保護された壁紙の場合は一時停止し、ディスプレイごとの確認を待ちます。"
          }
        }
      }
    },
    "开启自动同步": {
      "extractionState": "manual",
      "localizations": {
        "en": {
