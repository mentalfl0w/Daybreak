          }
        }
      }
    },
    "回到所选地区的当前来源月份": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return to the current source month for the selected region"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した地域の現在のソース月に戻る"
          }
        }
      }
    },
    "回到本月": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to this month"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月に戻る"
          }
        }
      }
    },
    "回顾": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recap"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "振り返り"
          }
        }
      }
    },
    "回顾只读取本机已经保存的记录。没有记录时不会补写图片、日期或介绍。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recap only reads records already saved on this device. It won't write images, dates, or stories when there are no records."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "振り返りは本機に保存済みの記録だけを読み取ります。記録がない場合、画像、日付、ストーリーを補完して書き込むことはありません。"
          }
        }
      }
    },
    "回顾视图": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recap view"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "振り返り表示"
          }
        }
      }
    },
    "固定日期": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinned date"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定日付"
          }
        }
      }
    },
    "图库": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Library"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリ"
          }
        }
      }
    },
    "图库与日历只读取本机缓存，不会联网补造缺失日期。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Library and Calendar only read the local cache and won't go online to fill in missing dates."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリとカレンダーはローカルキャッシュのみを読み込み、不足している日付をオンラインで補うことはありません。"
          }
        }
      }
    },
    "图库或日历": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Library or Calendar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリまたはカレンダー"
          }
        }
      }
    },
    "图库用于连续浏览有记录的图片；日历会显示整月每一天的实际状态。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Library to browse recorded images in sequence; Calendar shows the actual status of each day in the month."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
