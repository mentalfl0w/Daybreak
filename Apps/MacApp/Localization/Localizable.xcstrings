            "value": "一部の日付に記録あり"
          }
        }
      }
    },
    "每天都有记录": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records every day"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日記録あり"
          }
        }
      }
    },
    "日期未知": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Date unknown"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付不明"
          }
        }
      }
    },
    "本机还没有可确认的观察起点，因此不补写任何日期；应用第一次保存记录之前的日期都不计入统计。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac has no confirmed first-record date yet, so no dates are filled in; dates before the app first saved a record are not counted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac にはまだ確認できる最初の記録日がないため、日付を補いません。アプリが最初に記録を保存する前の日付は集計しません。"
          }
        }
      }
    },
    "该月早于本机首次观察（%@），也就是应用第一次保存记录之前；不计入统计，也不会补造图片。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This month is earlier than this Mac's first observation (%@), i.e. before the app first saved a record; it is not counted and no images are invented."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この月はこの Mac の最初の観察（%@）、つまりアプリが最初に記録を保存するより前です。集計対象外で、画像を補うこともありません。"
          }
        }
      }
    },
    "该月没有本机记录。这不代表 Bing 当时没有发布图片：应用可能未运行、未获取该地区内容，或网络请求失败。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac has no records for this month. That does not mean Bing published no image then: the app may not have been running, may not have fetched this region's content, or a request may have failed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この月の記録はこの Mac にありません。Bing が当時画像を公開しなかったという意味ではありません。アプリが起動していなかった、この地域の内容を取得していない、または通信に失敗した可能性があります。"
          }
        }
      }
    },
    "本机还没有可确认的观察起点，因此不补写任何月份；应用第一次保存记录之前的月份都不计入统计。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac has no confirmed first-record date yet, so no months are filled in; months before the app first saved a record are not counted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac にはまだ確認できる最初の記録日がないため、月を補いません。アプリが最初に記録を保存する前の月は集計しません。"
          }
        }
      }
    },
    "该年早于本机首次观察（%@），也就是应用第一次保存记录之前；不计入统计，也不会补造月份。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This year is earlier than this Mac's first observation (%@), i.e. before the app first saved a record; it is not counted and no months are invented."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この年はこの Mac の最初の観察（%@）、つまりアプリが最初に記録を保存するより前です。集計対象外で、月を補うこともありません。"
          }
        }
      }
    },
    "本机从 %@ 开始记录；该年此前的日期不计入统计范围。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records on this Mac start on %@; earlier dates that year are outside the counted range."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac の記録は %@ から始まります。その年より前の日付は集計範囲に含まれません。"
          }
        }
      }
    },
    "该年没有本机记录。这不代表 Bing 当时没有发布图片：应用可能未运行或未获取内容。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac has no records for this year. That does not mean Bing published no image then: the app may not have been running or may not have fetched content."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この年の記録はこの Mac にありません。Bing が当時画像を公開しなかったという意味ではありません。アプリが起動していなかった、または内容を取得していない可能性があります。"
          }
        }
      }
    },
    "未命名显示器": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unnamed display"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名称のないディスプレイ"
          }
        }
      }
    },
    "接受部分壁纸无法读取": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I accept that some wallpapers can't be read"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の壁紙を読み取れないことを受け入れます"
          }
        }
      }
    },
    "Daybreak 只修改当前可访问的桌面；手动应用不会自动更新其他 Space。开启自动同步后，切换时才可能尝试更新，且不保证立即生效。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daybreak changes only the desktops you can currently access. Manual apply does not update other Spaces automatically. After you turn on auto sync, switching to another Space may attempt an update, but an immediate update is not guaranteed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Daybreak は現在アクセスできるデスクトップのみを変更します。手動適用では他の Space は自動更新されません。自動同期をオンにした後、Space を切り替えると更新を試みる場合がありますが、即時に反映される保証はありません。"
          }
        }
      }
    },
    "显示器：%@（只修改当前可访问的桌面）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display: %@ (only currently accessible desktops are changed)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイ：%@（現在アクセスできるデスクトップのみ変更）"
          }
        }
      }
    },
    "全部 %lld 台已连接显示器（只修改当前可访问的桌面）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All %lld connected displays (only currently accessible desktops are changed)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続中の全 %lld 台のディスプレイ（現在アクセスできるデスクトップのみ変更）"
          }
        }
      }
    },
    "%@：无法读取当前壁纸。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: The current wallpaper can't be read."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：現在の壁紙を読み取れません。"
          }
        }
      }
    },
    "这次写入确认已过期，请重新打开确认面板。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This write confirmation has expired. Open the confirmation panel again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この書き込み確認は期限切れです。確認パネルを開き直してください。"
          }
        }
      }
    },
    "确认项与要求不一致，请重新确认。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The acknowledgements don't match what's required. Please confirm again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認項目が要件と一致しません。もう一度確認してください。"
          }
        }
      }
    },
    "未能确认自动写入已经关闭。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't confirm that automatic writes are off."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動書き込みがオフになったことを確認できませんでした。"
          }
        }
      }
    },
    "已按确认更新壁纸。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallpaper updated as confirmed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認どおりに壁紙を更新しました。"
          }
        }
      }
    },
    "自动同步已开启。现在不会写入壁纸；之后的内容更新、Space 切换、显示器变化或唤醒时会检查并应用已设置的目标。新接入的显示器不一定已有目标，可能暂时不会自动更新。未激活的 Space 不会立即更新。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto sync is on. Nothing is written now. After a content update, Space switch, display change, or wake, Daybreak checks and applies the configured targets. A newly connected display may not have a target yet and may not update automatically for now. Inactive Spaces are not updated immediately."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動同期をオンにしました。すぐには書き込みません。以降のコンテンツ更新、Space の切り替え、ディスプレイの変更、スリープ解除時に、設定済みのターゲットを確認して適用します。新しく接続したディスプレイにはターゲットがまだない場合があり、当面は自動更新されないことがあります。非アクティブな Space は直ちに更新されません。"
          }
        }
      }
    },
    "自动写入可能仍在生效，请重试关闭自动同步。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic writes may still be active. Try turning off auto sync again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動書き込みがまだ有効な可能性があります。自動同期をもう一度オフにしてください。"
          }
        }
      }
    },
    "自动同步没有生效：当前无法写入壁纸。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto sync isn't active: wallpapers can't be written right now."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動同期は有効になりませんでした。現在は壁紙を書き込めません。"
          }
        }
      }
    },
    "已按确认覆盖当前壁纸。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current wallpaper overwritten as confirmed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認どおりに現在の壁紙を上書きしました。"
          }
        }
      }
    },
    "未能确认自动同步已关闭；开关和错误信息显示的是当前状态。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't confirm auto sync is off; the switch and error information show the current state."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動同期がオフになったことを確認できませんでした。スイッチとエラー情報は現在の状態を示しています。"
          }
        }
      }
    },
    "本次会话已停止自动写入，但保存的设置可能仍为自动同步；重新启动后可能恢复，请重试关闭。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic writes stopped for this session, but the saved setting may still enable auto sync; it may return after a restart. Try turning it off again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセッションでは自動書き込みを停止しましたが、保存された設定は自動同期のままの可能性があります。再起動後に戻る場合があるため、もう一度オフにしてください。"
          }
        }
      }
    },
    "自动同步已关闭；清理旧目标失败，下次开启时会重新设置。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto sync is off. Cleaning up the old target failed; it will be set again next time you turn it on."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動同期をオフにしました。古い対象の整理に失敗しましたが、次回オンにしたときに再設定します。"
          }
        }
      }
    },
    "自动同步目标已更新；将在下次 Space 切换、显示器变化或唤醒时应用。之后新接入的显示器不一定已有目标。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-sync targets updated. They will be applied at the next Space switch, display change, or wake. A display connected later may not have a target yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動同期のターゲットを更新しました。次回の Space 切り替え、ディスプレイ変更、スリープ解除時に適用します。後から接続したディスプレイにはターゲットがまだない場合があります。"
          }
        }
      }
    },
    "自动同步目标已更新；已断开的自动目标也会在重新接入时使用新图。将在下次 Space 切换、显示器变化、唤醒，或鼠标进入另一台显示器时应用。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-sync targets updated. Automatic targets for disconnected displays will use the new image when they reconnect. They will be applied at the next Space switch, display change, wake, or when the pointer enters another display."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動同期のターゲットを更新しました。切断中のディスプレイの自動ターゲットも、再接続時に新しい画像を使用します。次回の Space 切り替え、ディスプレイ変更、スリープ解除、またはポインタが別のディスプレイに移動したときに適用します。"
          }
        }
      }
    },
    "%lld 台显示器保留迁移前目标，自动同步不会更新它们；重新开启自动同步后可纳入。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld displays keep their pre-migration targets; auto sync will not update them. Turn auto sync off and on again to include them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 台のディスプレイは移行前のターゲットを保持しており、自動同期は更新しません。含めるには自動同期をオフにしてから再度オンにしてください。"
          }
        }
      }
    },
    "%lld 台显示器保留手动目标。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld displays keep their manual targets."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 台のディスプレイは手動ターゲットを保持しています。"
          }
        }
      }
    },
    "%lld 台显示器使用迁移前的目标，自动同步不会更新它们；如需纳入，请关闭后重新开启自动同步。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld displays use pre-migration targets that auto sync will not update. To include them, turn auto sync off and on again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 台のディスプレイは移行前のターゲットを使用しており、自動同期は更新しません。含めるには、自動同期をオフにしてから再度オンにしてください。"
          }
        }
      }
    },
    "当前没有连接的显示器。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No displays are currently connected."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在接続されているディスプレイはありません。"
          }
        }
      }
    },
    "未能确认自动写入已关闭。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't confirm automatic writes are off."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動書き込みがオフになったことを確認できませんでした。"
          }
        }
      }
    },
    "写入已暂停，没有覆盖任何未知壁纸。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writing paused; no unknown wallpaper was overwritten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き込みを一時停止しました。不明な壁紙は上書きしていません。"
          }
        }
      }
    },
    "当前壁纸不是 Daybreak 设置的，或尚未确认要覆盖；为避免覆盖你的选择，已暂停。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current wallpaper wasn't set by Daybreak, or overwriting it hasn't been confirmed. Writing paused to avoid replacing your choice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の壁紙は Daybreak が設定したものではないか、上書きの確認が済んでいません。選択を上書きしないよう一時停止しました。"
          }
        }
      }
    },
    "当前壁纸不是 Daybreak 设置的，或尚未确认要覆盖；已暂停。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current wallpaper wasn't set by Daybreak or hasn't been confirmed for overwrite; paused."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の壁紙は Daybreak が設定したものではないか、上書き確認が済んでいません。一時停止しました。"
          }
        }
      }
    },
    "这台显示器的当前壁纸已设为手动保护；已暂停。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This display's current wallpaper is manually protected; paused."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このディスプレイの現在の壁紙は手動で保護されています。一時停止しました。"
          }
        }
      }
    },
    "无法读取部分显示器的当前壁纸。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current wallpaper can't be read on some displays."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のディスプレイで現在の壁紙を読み取れません。"
          }
        }
      }
    },
    "无法完整读取部分壁纸的显示设置。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some wallpaper display settings can't be fully read."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の壁紙表示設定を完全に読み取れません。"
          }
        }
      }
    },
    "确认后会立即更新当前可访问的桌面。如果无法确认当前壁纸，写入会暂停并显示原因。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After you confirm, Daybreak updates the currently accessible desktops right away. If the current wallpaper can't be confirmed, writing pauses and shows why."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認すると、現在アクセスできるデスクトップをすぐに更新します。現在の壁紙を確認できない場合は書き込みを一時停止し、理由を表示します。"
          }
        }
      }
    },
    "开启后不会立即写入。之后的内容更新、Space 切换、显示器变化或唤醒时才可能应用；只会修改当前可访问的桌面，未激活的 Space 需要切换后才会更新。未知或受保护的壁纸会暂停并等待按显示器确认。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is written right after you turn it on. Later content updates, Space switches, display changes, or wake events may apply it; only currently accessible desktops are changed, and inactive Spaces update after you switch to them. Unknown or protected wallpapers pause and wait for per-display confirmation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにした直後は書き込みません。以降のコンテンツ更新、Space の切り替え、ディスプレイの変更、スリープ解除時に適用される場合があります。変更するのは現在アクセスできるデスクトップのみで、非アクティブな Space は切り替えた後に更新されます。不明な壁紙や保護された壁紙は一時停止し、ディスプレイごとの確認を待ちます。"
          }
        }
      }
    },
    "无法读取的壁纸": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallpapers that can't be read"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取れない壁紙"
          }
        }
      }
    },
    "本次确认有效至 %@。过期后需要重新准备并再次确认。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This confirmation is valid until %@. After it expires, prepare and confirm again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この確認は %@ まで有効です。期限切れ後は再度準備して確認してください。"
          }
        }
      }
    },
    "手动应用只修改当前可访问的桌面；开启自动同步后，切换到其他 Space 时才可能再次更新，且不保证立即生效。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manual apply changes only the desktops you can currently access. After you turn on auto sync, switching to another Space may trigger another update, but an immediate update isn't guaranteed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手動適用では現在アクセスできるデスクトップのみ変更します。自動同期をオンにした後、他の Space に切り替えると再更新を試みる場合がありますが、即時反映は保証されません。"
          }
        }
      }
    },
    "自动同步默认关闭，每次启动后都需要重新确认。遇到未知或受手动保护的壁纸会暂停并显示原因，不会覆盖。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto sync is off by default and needs to be confirmed again after each launch. Unknown or manually protected wallpapers pause it and show the reason; nothing is overwritten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動同期は初期状態でオフで、起動のたびに再確認が必要です。不明な壁紙や手動で保護された壁紙を検出すると一時停止して理由を表示し、上書きはしません。"
          }
        }
      }
    },
    "打开写入确认并逐项检查": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the write confirmation and review each item"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き込み確認を開いて項目ごとに確認"
          }
        }
      }
    },
    "本次会话已停止自动写入，但保存的设置可能仍为自动同步；重新启动后可能恢复。请重试关闭。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic writes stopped for this session, but the saved setting may still enable auto sync; it may return after a restart. Try turning it off again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセッションでは自動書き込みを停止しましたが、保存された設定は自動同期のままの可能性があります。再起動後に戻る場合があるため、もう一度オフにしてください。"
          }
        }
      }
    },
    "%lld 台显示器等待按显示器确认": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld displays awaiting per-display confirmation"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 台のディスプレイがディスプレイごとの確認待ち"
          }
        }
      }
    },
    "已有等待确认的写入": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A write is already awaiting confirmation"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認待ちの書き込みがあります"
          }
        }
      }
    },
    "本次会话已停止自动写入，但保存的设置可能仍为自动同步；重新启动后可能恢复。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic writes stopped for this session, but the saved setting may still enable auto sync; it may return after a restart."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセッションでは自動書き込みを停止しましたが、保存された設定は自動同期のままの可能性があります。再起動後に戻る場合があります。"
          }
        }
      }
    },
    "开启后会自动检查并应用壁纸；未激活的 Space 不会立即更新。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, Daybreak checks and applies the wallpaper automatically; inactive Spaces aren't updated immediately."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると壁紙を自動で確認して適用します。非アクティブな Space は直ちに更新されません。"
          }
        }
      }
    },
    "无法确认这段介绍属于这张图片，已隐藏。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This story couldn't be matched to this image, so it's hidden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この紹介がこの画像のものか確認できないため、非表示にしました。"
          }
        }
      }
    },
    "写入前需在今日窗口逐项确认；只修改当前可访问的桌面。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm each item in the Today window before writing; only currently accessible desktops are changed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き込み前に「今日」ウインドウで項目ごとに確認してください。変更するのは現在アクセスできるデスクトップのみです。"
          }
        }
      }
    },
    "取消这次写入": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel this write"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この書き込みをキャンセル"
          }
        }
      }
    },
    "有壁纸写入等待确认": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A wallpaper write is awaiting confirmation"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "壁紙の書き込みが確認待ちです"
          }
        }
      }
    },
    "完成或取消这次写入后才能更改自动同步。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish or cancel this write before changing auto sync."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この書き込みを完了またはキャンセルするまで、自動同期は変更できません。"
          }
        }
      }
    },
    "默认关闭，每次启动后都需要在今日窗口重新确认。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default; confirm again in the Today window after each launch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初期状態ではオフで、起動のたびに「今日」ウインドウで再確認が必要です。"
          }
        }
      }
    },
    "执行时机": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When it runs"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行タイミング"
          }
        }
      }
    },
    "执行范围": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scope"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行範囲"
          }
        }
      }
    },
    "自动同步开启且应用运行时，Daybreak 会按内容地区的日期获取新内容，失败后间隔重试；获取到新内容后，以及 Space 切换、显示器变化或唤醒时，会检查并应用壁纸。未激活的 Space 不会立即更新。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While auto sync is on and the app is running, Daybreak fetches new content based on the content region's date and retries after a failure. It checks and applies the wallpaper after new content arrives, and on Space switches, display changes, or wake. Inactive Spaces aren't updated immediately."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動同期がオンでアプリの実行中、Daybreak はコンテンツ地域の日付に合わせて新しい内容を取得し、失敗時は間隔を空けて再試行します。新しい内容の取得後、および Space の切り替え、ディスプレイの変更、スリープ解除時に壁紙を確認して適用します。非アクティブな Space は直ちに更新されません。"
          }
        }
      }
    },
    "Space 切换后，Daybreak 会重新检查并尽力恢复壁纸，但不保证未激活的 Space 立即更新。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After a Space switch, Daybreak rechecks and makes a best effort to restore the wallpaper, but doesn't guarantee an immediate update in inactive Spaces."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Space を切り替えると、Daybreak は壁紙を再確認して復元を試みますが、非アクティブな Space が直ちに更新される保証はありません。"
          }
        }
      }
    },
    "无法确认当前壁纸时会暂停写入，不会覆盖未知壁纸。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the current wallpaper can't be confirmed, writing pauses instead of overwriting an unknown wallpaper."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の壁紙を確認できない場合は書き込みを一時停止し、不明な壁紙を上書きしません。"
          }
        }
      }
    },
    "写入范围": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write scope"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き込みの範囲"
          }
        }
      }
    },
    "正在准备写入确认": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing write confirmation"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き込み確認を準備中"
          }
        }
      }
    },
    "正在准备写入确认…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing write confirmation…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き込み確認を準備中…"
          }
        }
      }
    },
    "本次会话已停止自动写入，请先重试关闭自动同步": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic writes stopped for this session; try turning off auto sync first"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセッションでは自動書き込みを停止しました。先に自動同期のオフを再試行してください"
          }
        }
      }
    },
    "以下显示器的当前壁纸不是 Daybreak 设置的，或尚未确认要覆盖；写入会暂停，不会覆盖未知壁纸。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current wallpaper on these displays wasn't set by Daybreak, or overwriting it hasn't been confirmed. Writing pauses and won't overwrite an unknown wallpaper."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のディスプレイの現在の壁紙は Daybreak が設定したものではないか、上書きの確認が済んでいません。書き込みを一時停止し、不明な壁紙は上書きしません。"
          }
        }
      }
    },
    "按显示器确认": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Per-display confirmation"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイごとの確認"
          }
        }
      }
    },
    "确认面板在今日窗口显示。只会修改当前可访问的桌面；未激活的 Space 不会立即更新。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The confirmation panel appears in the Today window. Only currently accessible desktops are changed; inactive Spaces aren't updated immediately."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認パネルは「今日」ウインドウに表示されます。変更するのは現在アクセスできるデスクトップのみで、非アクティブな Space は直ちに更新されません。"
          }
        }
      }
    },
    "正在载入本地内容…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading local content…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルコンテンツを読み込み中…"
          }
        }
      }
    },
    "跟随系统（当前为 %@）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow System (currently %@)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムに従う（現在は %@）"
          }
        }
      }
    },
    "默认跟随系统地区和首选语言，只有手动选择地区后才会保存。地区决定图片、来源日期和介绍原文；切换后会先显示该地区已缓存的内容，再尝试联网更新，不会用其他地区的文字填补。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By default, Daybreak follows the system region and preferred language; a region is saved only after you choose one manually. The region determines the image, source date, and original story. After switching, cached content for that region is shown first, then Daybreak tries to update online; text from other regions is never used as filler."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初期設定ではシステムの地域と言語に従い、手動で地域を選んだ場合のみ保存します。地域によって画像、ソース日付、紹介文が決まります。切り替え後はその地域のキャッシュを先に表示し、その後オンライン更新を試みます。他の地域の文章で補うことはありません。"
          }
        }
      }
    },
    "来源日期按各地区的时区计算。这些时区由 Daybreak 设定，Bing 未公开确认，因此日期可能与 Bing 页面显示的不完全一致。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source dates are calculated using each region's time zone. These zones are set by Daybreak and haven't been publicly confirmed by Bing, so dates may differ slightly from what Bing shows."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソース日付は各地域のタイムゾーンで計算します。このタイムゾーンは Daybreak が設定したもので Bing が公表・確認したものではないため、Bing の表示と日付が完全には一致しない場合があります。"
          }
        }
      }
    },
    "地区列表来自 Bing 公开提供的地区代码。不同地区的每日图片可能相同，Daybreak 无法始终确认是否发生了地区回退。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The region list uses region codes publicly provided by Bing. Daily images may be the same across regions, and Daybreak can't always tell whether a region fallback occurred."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地域一覧は Bing が公開している地域コードに基づいています。地域によっては毎日の画像が同じことがあり、地域のフォールバックが起きたか常に確認できるわけではありません。"
          }
        }
      }
    },
    "Daybreak 是一款 Bing 每日壁纸客户端，可以浏览来源介绍、时光日历和本地回顾；已缓存的内容可离线查看。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daybreak is a Bing daily wallpaper client for browsing source stories, the timeline calendar, and local recaps; cached content is available offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Daybreak は Bing の日替わり壁紙クライアントです。ソースの紹介、タイムラインカレンダー、ローカルの振り返りを閲覧でき、キャッシュ済みの内容はオフラインでも表示できます。"
          }
        }
      }
    },
    "图片、图片信息与来源介绍只保存在本机；Daybreak 不上传浏览记录，也没有账号系统或后台服务。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Images, image details, and source stories stay on this Mac. Daybreak doesn't upload browsing history and has no account system or backend service."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像、画像情報、ソースの紹介はこの Mac にのみ保存されます。Daybreak は閲覧履歴をアップロードせず、アカウントシステムやバックエンドサービスもありません。"
          }
        }
      }
    },
    "只注册 Daybreak 本身，不会改动其他登录项；可以随时在系统设置的登录项中停用。壁纸写入仍需要先完成确认。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only Daybreak itself is registered; other login items aren't changed. You can disable it anytime in Login Items in System Settings. Wallpaper writes still require confirmation first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録されるのは Daybreak のみで、他のログイン項目は変更しません。システム設定のログイン項目でいつでも無効にできます。壁紙の書き込みには引き続き確認が必要です。"
          }
        }
      }
    },
    "按缓存记录统计缩略图与原图的占用；图片信息与介绍不计入其中。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage counts thumbnails and originals tracked in the cache records; image details and stories aren't included."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用量はキャッシュ記録にあるサムネイルとオリジナルの合計です。画像情報と紹介は含まれません。"
          }
        }
      }
    },
    "容量条只对照内置默认上限；收藏、固定日期与当前壁纸不会被清理。记录仍在但文件已缺失的项目，仍可能计入占用。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The capacity bar only compares against the built-in defaults. Favorites, pinned dates, and the current wallpaper aren't cleaned up. Items whose records remain but files are missing may still count toward usage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "容量バーは内蔵の既定上限との比較のみを行います。お気に入り、固定日付、現在の壁紙はクリーンアップされません。記録が残っていてもファイルが欠けている項目は、使用量に含まれる場合があります。"
          }
        }
      }
    },
    "每个操作都会先确认；受保护图片不会被删除，图片信息与收藏保持不变。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every action asks for confirmation first; protected images aren't deleted, and image details and favorites stay unchanged."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各操作は事前に確認します。保護された画像は削除されず、画像情報とお気に入りは変わりません。"
          }
        }
      }
    },
    "按缩略图 %@、原图 %@ 清理最久未使用的缓存。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clean the least recently used cache to keep thumbnails under %1$@ and originals under %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サムネイル %1$@、オリジナル %2$@ を上限に、最も長く使われていないキャッシュから整理します。"
          }
        }
      }
    },
    "只删除已缓存的每日介绍；图片、图片信息与收藏不受影响。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only cached daily stories are deleted; images, image details, and favorites aren't affected."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除するのはキャッシュ済みの毎日の紹介のみです。画像、画像情報、お気に入りには影響しません。"
          }
        }
      }
    },
    "修复本地缓存": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repair local cache"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルキャッシュを修復"
          }
        }
      }
    },
    "移除缓存中没有任何记录引用的残留文件，并检查记录中缺失的文件；不会删除图片信息或收藏。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove leftover files that no cache record references, and check for files missing from records; image details and favorites aren't deleted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの記録からも参照されていない残留ファイルを削除し、記録にあるのに欠けているファイルを確認します。画像情報やお気に入りは削除しません。"
          }
        }
      }
    },
    "修复缓存": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repair cache"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュを修復"
          }
        }
      }
    },
    "图片信息与介绍可能仍保存在本机，但不在此列表中。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Image details and stories may still be saved on this Mac but aren't in this list."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像情報と紹介はこの Mac に残っていても、この一覧には表示されません。"
          }
        }
      }
    },
    "这些图片不会被自动清理。壁纸保护会保留较多历史图片，数量可能高于当前可见桌面的实际用量。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These images aren't cleaned up automatically. Wallpaper protection keeps more historical images, so the count may be higher than what's actually used on currently visible desktops."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの画像は自動クリーンアップされません。壁紙保護は過去の画像を多めに保持するため、現在表示中のデスクトップで実際に使われている数より多くなることがあります。"
          }
        }
      }
    },
    "壁纸保护的数量不代表当前可见桌面的实际数量。取消收藏前会先确认，因为取消后图片可能被后续清理删除。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The wallpaper protection count doesn't equal what's currently visible on your desktops. Removing a favorite asks for confirmation first, because later cleanup may delete its images."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "壁紙保護の数は、現在表示中のデスクトップで実際に使われている数と同じではありません。お気に入りを解除する前に確認します。解除後は後続のクリーンアップで画像が削除される場合があります。"
          }
        }
      }
    },
    "含可能仍被其他 Space 使用的历史图片": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes historical images that other Spaces may still use"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他の Space でまだ使われている可能性がある過去の画像を含む"
          }
        }
      }
    },
    "只删除未被收藏、固定或当前正在使用的缩略图；原图与介绍保留。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only thumbnails that aren't favorited, pinned, or currently in use are deleted; originals and stories are kept."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入り、固定日付、現在使用中のいずれでもないサムネイルのみ削除します。オリジナルと紹介は残ります。"
          }
        }
      }
    },
    "无法确认介绍属于这张图片": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't confirm this story belongs to this image"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この紹介がこの画像のものか確認できません"
          }
        }
      }
    },
    "当天有介绍，但无法确认它属于这张图片，因此没有显示，以免错配。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A story exists for that day, but it can't be confirmed as belonging to this image, so it isn't shown to avoid a mismatch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その日の紹介はありますが、この画像のものか確認できないため、誤った組み合わせを避けて表示していません。"
          }
        }
      }
    },
    "日期按来源地区的日历计算，不根据本机时钟推断。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dates follow the source region's calendar and aren't inferred from this Mac's clock."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付はソース地域のカレンダーで計算し、この Mac の時計から推測しません。"
          }
        }
      }
    },
    "本机有这一天的记录，但无法读取图片与介绍详情。可以稍后重新读取；不会用相邻日期的内容替代。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac has a record for this day, but its image and story details can't be read. Try reloading later; content from nearby dates isn't substituted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この日の記録はこの Mac にありますが、画像と紹介の詳細を読み取れません。後で再読み込みできます。隣接する日付の内容で代用することはありません。"
          }
        }
      }
    },
    "图库与日历只读取本机缓存，不会联网补造缺失的日期。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gallery and Calendar read only the local cache; missing dates aren't filled in from the network."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ギャラリーとカレンダーはローカルキャッシュのみを読み込み、不足する日付をネットワークから補うことはありません。"
          }
        }
      }
    },
    "只显示本机实际记录。没有记录不代表 Bing 当天没有发布，也不会在回顾统计中补成 0 张。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only actual local records are shown. A missing record doesn't mean Bing published nothing that day, and recap statistics won't fill it in as zero images."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示するのはこの Mac の実際の記録のみです。記録がないことは Bing がその日に画像を公開しなかったという意味ではなく、振り返りの統計でも 0 枚として補いません。"
          }
        }
      }
    },
    "已忽略之前保存的地区“%@”（不在可选的 Bing 地区中），当前跟随系统。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previously saved region “%@” was ignored because it isn't an available Bing region; following the system now."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前保存した地域「%@」は利用可能な Bing 地域にないため無視し、システムに従います。"
          }
        }
      }
    },
    "系统地区和首选语言没有完全对应的 Bing 地区；已按语言使用 %@，这不是系统地区的内容。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Bing region exactly matches the system region and preferred language. Using %@ based on the language; this isn't the system region's content."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムの地域と言語に完全に一致する Bing 地域がないため、言語に基づき %@ を使用します。システム地域のコンテンツではありません。"
          }
        }
      }
    },
    "首选语言没有对应的 Bing 地区；已按系统地区使用 %@，这不是系统语言的内容。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Bing region matches the preferred language. Using %@ based on the system region; this isn't content in the system language."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "優先言語に一致する Bing 地域がないため、システム地域に基づき %@ を使用します。システム言語のコンテンツではありません。"
          }
        }
      }
    },
    "系统语言和地区没有对应的 Bing 地区；暂用 %@，可以在下方手动选择。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Bing region matches the system language and region. Using %@ for now; you can choose another below."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムの言語と地域に一致する Bing 地域がないため、現在は %@ を使用します。下で別の地域を選択できます。"
          }
        }
      }
    },
    "本地缓存尚未准备好": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local cache isn't ready yet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルキャッシュの準備ができていません"
          }
        }
      }
    },
    "无法记录当前壁纸的缓存保护：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't record cache protection for the current wallpaper: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の壁紙のキャッシュ保護を記録できませんでした：%@"
          }
        }
      }
    },
    "不支持这个地区，它不在可选的 Bing 地区中。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This region isn't supported because it isn't an available Bing region."
